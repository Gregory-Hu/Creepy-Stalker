# 环境变量配置文件
# 复制此文件为 .env 并填入你的 API Key

# ========== LLM 配置 ==========

# DeepSeek API Key
LLM_API_KEY=sk-your-deepseek-api-key-here

# DeepSeek 模型 (使用 LiteLLM 格式)
LLM_MODEL=deepseek/deepseek-chat

# DeepSeek API 端点
LLM_BASE_URL=https://api.deepseek.com

# ========== 可选配置 ==========

# 工作目录
WORKSPACE_DIR=./workspace

# 记忆存储路径
MEMORY_STORAGE_PATH=./workspace/memory

# 报告输出目录
REPORTS_DIR=./reports
